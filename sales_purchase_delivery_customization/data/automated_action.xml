<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="automation_on_delivery_done" model="base.automation">
                <field name="name">Send Mail on Delivery Done</field>
                <field name="model_id" ref="stock.model_stock_picking"/>
                <field name="trigger">on_state_set</field>
                <field name="filter_domain">
                        ["&amp;", ("sale_id.user_id.partner_id.email", "!=", False), ("state", "=", "done")]
                </field>
                <field name="trg_selection_field_id" ref="stock.selection__stock_picking__state__done"/>
        </record>

        <record id="action_send_mail_delivery_done" model="ir.actions.server">
                <field name="name">Send Mail on Delivery Done</field>
                <field name="model_id" ref="stock.model_stock_picking"/>
                <field name="base_automation_id" ref="automation_on_delivery_done"/>
                <field name="state">mail_post</field>
                <field name="mail_post_method">email</field>
                <field name="template_id" ref="stock.mail_template_data_delivery_confirmation"/>
        </record>
</odoo>
